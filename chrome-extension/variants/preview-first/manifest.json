{
  "manifest_version": 3,
  "name": "ReCalc Sender",
  "version": "10.7.2",
  "description": "ReCalc Sender offline-first: campañas locales sin inicio de sesión, conexión visible con ReCalc y sincronización manual de resultados.",
  "minimum_chrome_version": "114",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "panel-offline.html"
  },
  "background": {
    "service_worker": "background-offline.js"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "tabs",
    "alarms",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://recalc.relead.com.mx/*",
    "https://web.whatsapp.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'self';"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "content-whatsapp.js",
        "content/bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "version_name": "10.7.2 · conexión visible con ReCalc"
}
